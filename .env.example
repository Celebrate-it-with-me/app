# Origin of the admin panel allowed to embed /preview/invitation and send it previews (postMessage).
# Local: http://dev.admin.cwm.com
VITE_ADMIN_URL=http://dev.admin.cwm.com

# Social sign-in buttons shown on sign-in / sign-up (comma separated: google, facebook). Leave only google while Meta is not ready.
VITE_SOCIAL_PROVIDERS=google,facebook

# Origin the invitation loads template-package assets (CSS, SVG, fonts) from; local: the API host.
VITE_TEMPLATE_ASSETS_ORIGIN=http://dev.api.cwm.com
