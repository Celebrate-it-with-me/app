{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/preview/invitation",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors https://admin.quinvite.com" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/i/:slug/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Applebot|SkypeUriPreview|Pinterest|Googlebot).*"
        }
      ],
      "destination": "https://api.quinvite.com/og/:slug/:code"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
