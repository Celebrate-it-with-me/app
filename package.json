{
  "name": "cwm_app",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prod": "vite build --mode prod",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "test:coverage:changed": "node scripts/coverage-changed.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:changed": "git diff --name-only --diff-filter=ACM | xargs eslint",
    "format:changed": "git diff --name-only --diff-filter=ACM | xargs prettier --write",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@vuepic/vue-datepicker": "^14.0.0",
    "axios": "1.21.1",
    "date-fns": "^4.1.0",
    "detect-browser": "^5.3.0",
    "lightgallery": "^2.8.2",
    "lodash.debounce": "^4.0.8",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.11.0",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "^2.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "glob": "^14.0.4"
  }
}
