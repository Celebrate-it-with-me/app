      "id": "cover_photo",
      "type": "image",
      "group": "cover",
      "label": {
        "es": "Foto de portada",
        "en": "Cover photograph"
      },
      "help": {
        "es": "Sube tu foto (también sirve una imagen ya compuesta con fondo). Mejor vertical 4:5, mínimo 960 px de ancho.",
        "en": "Upload your photo (an already composed image with background works too). Best as portrait 4:5, at least 960 px wide."
      },
      "bind": {
        "section": "cover",
        "setting": "image",
        "focus": "focus"
      },
      "minWidth": 960,
      "required": false,
      "plan": "free"
    },
    {
      "id": "cover_title",
      "type": "text",
      "group": "cover",
      "label": {
        "es": "Frase sobre la foto",
        "en": "Line above the photo"
      },
      "bind": {
        "section": "cover",
        "field": "title"
      },
      "max": {
        "es": 60,
        "en": 60
      },
      "plan": "free"
    },
